{
  "name": "links-app",
  "version": "0.1.0",
  "private": true,
  "description": "Links — a Spotify companion app that keeps chained tracks together during shuffle.",
  "author": "Civoen",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron:dev\"",
    "electron:dev": "tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "dist": "npm run build && electron-builder --publish=never",
    "release": "npm run build && electron-builder --publish=always",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "build": {
    "appId": "app.links.desktop",
    "productName": "Links",
    "files": ["dist/**/*", "dist-electron/**/*", "build/**/*"],
    "directories": { "output": "release" },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Links-Setup.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Audio",
      "icon": "build/icon.png",
      "artifactName": "Links.${ext}"
    }
  }
}

